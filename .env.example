# TokenRouter environment variables
# Copy to .env and fill in real values. Never commit .env.

# Clean APIs — one variable per legitimate account you own.
# The router discovers every CLEAN_API_KEY_<n> that is set, so account numbers
# are never hardcoded anywhere. Keys stay in the environment: they are never
# written to config.yaml, the SQLite database, logs or API responses.

CLEAN_API_KEY_1=sk-clean-replace-me

# Optional additional accounts (used from M2 onwards)
# CLEAN_API_KEY_2=sk-clean-replace-me
# CLEAN_API_KEY_3=sk-clean-replace-me

# Optional overrides
# TOKENROUTER_CONFIG=config.yaml
# TOKENROUTER_HOST=127.0.0.1
# TOKENROUTER_PORT=8787
# TOKENROUTER_UPSTREAM_BASE_URL=https://cleanapis.com/v1
# TOKENROUTER_DB_PATH=data/tokenrouter.db
# TOKENROUTER_ROUTING_STRATEGY=max_remaining
# TOKENROUTER_MAX_FALLBACK_ATTEMPTS=2
